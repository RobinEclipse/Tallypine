{
  "name": "tallypine-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Tallypine: a private, offline transaction tracker",
  "main": "dist-electron/electron/main.js",
  "author": "Tallypine",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run test && npm run build:electron && vite build",
    "package": "npm run build && electron-builder --win nsis portable",
    "start": "npm run build && electron ."
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.tallypine.desktop",
    "productName": "Tallypine",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "en-US",
      "en-GB"
    ],
    "directories": {
      "output": "release-electron"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/tallypine.ico",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "build/tallypine.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Tallypine-Setup-1.0.0.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tallypine",
      "uninstallDisplayName": "Tallypine 1.0"
    },
    "portable": {
      "artifactName": "Tallypine-Portable-1.0.0.${ext}"
    }
  }
}
